[gmeow]
data_dir = "data"
host = "127.0.0.1"
port = 8765
postgres_dsn = "postgresql://gmeow:change-me@127.0.0.1:5432/gmeow"
auth_mode = "service_account"
subject = "user@example.com"
service_account_file = "data/secrets/service-account.json"
user_credentials_file = "~/.config/gcloud/application_default_credentials.json"
embedding_model = "nomic-embed-text-v1.5.Q8_0.gguf"
embedding_endpoint = "http://127.0.0.1:8090/v1/embeddings"
semantic_chunk_size = 192
semantic_chunk_overlap = 32

[gmeow.secrets]
file = "~/.config/gmeow/secrets.sops.yaml"
unlock_key = "replace-with-local-unlock-key"
age_key = "AGE-SECRET-KEY-REPLACE-WITH-LOCAL-SOPS-AGE-IDENTITY"

[gmeow.maintenance]
enabled = true
run_on_startup = false
sync_history_seconds = 300
sync_history_limit = 500
sync_priority_seconds = 3600
sync_priority_limit_per_rule = 100
intelligence_seconds = 30
intelligence_limit = 25
backfill_enabled = false
backfill_seconds = 5
backfill_batch_size = 50
backfill_max_empty_windows = 120
derived_refresh_seconds = 900
analyze_seconds = 3600

[gmeow.attachment_analysis]
enabled = true
max_text_chars = 200000
pdf_text_enabled = true
ocr_enabled = true
ocr_languages = "eng"
archive_listing_enabled = true
pandoc_enabled = true
vision_caption_enabled = false
vision_caption_timeout_seconds = 60

[gmeow.archive]
require_rfc822 = true

[gmeow.archive.delete_policy]
default = "tombstone"
purge_labels = ["SPAM", "TRASH"]
purge_categories = []

[gmeow.imap]
enabled = false
host = "127.0.0.1"
port = 1143
username = "gmeow"
password_file = "data/secrets/imap-password"

[[gmeow.priority_rules]]
name = "recent_important"
gmail_query = "is:important OR newer_than:7d"
labels = []
from_domains = []
senders = []
recipients = []
attachment_mime = ["application/pdf"]
attachment_filename_contains = ["invoice", "statement"]
newer_than_days = 30
priority = 100
