[Unit]
Description=Gmeow local Gmail REST/MCP server
Documentation=file:/home/paudley/Active.running/gmeow/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/paudley/Active.running/gmeow
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/paudley/stage/root/bin/uv run gmeow --config /home/paudley/Active.running/gmeow/config.toml serve --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
