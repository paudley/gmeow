[system]
config_version = 1
instance_id = "local"
data_dir = "data"

[filestore]
root = "data/filestore"

[postgres]
enabled = false
host = "127.0.0.1"
port = 5432
database = "gmeow"
user = "gmeow"
password_secret = ""
ssl_mode = "disable"

[rabbitmq]
enabled = false
url_secret = ""

[scheduler]
enabled = false
scan_interval = "30s"
retry_limit = 3
retry_backoff = "30s"
queue_prefix = "gmeow:"
projection_refresh = true
background_loop = false
dead_letter_inspect_max = 20

[scheduler.priorities]
interactive = 100
forced = 90
fresh_ingest = 70
repair = 50
background = 10

[secrets]
# Production RabbitMQ URLs should use the gmeow vhost:
# rabbitmq_url = "amqp://gmeow:secret@127.0.0.1:5672/gmeow"

[[interfaces]]
name = "rest"
kind = "rest"
enabled = true
host = "127.0.0.1"
port = 8765

[[interfaces]]
name = "mcp"
kind = "mcp"
enabled = true
host = "127.0.0.1"
port = 8765

[[analysis.analyzers]]
name = "noop"
version = "phase00"
enabled = true
worker_kind = "go"

[[search.backends]]
name = "query"
kind = "query"
enabled = true
facets = ["*"]
