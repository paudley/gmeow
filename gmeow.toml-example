[system]
config_version = 1
instance_id = "local"
data_dir = "data"

[filestore]
root = "data/filestore"

[rpc.filestore]
network = "unix"
address = "/run/gmeow/filestore.sock"

[rpc.scheduler]
network = "unix"
address = "/run/gmeow/scheduler.sock"

[rpc.query]
network = "unix"
address = "/run/gmeow/query.sock"

[postgres]
host = "127.0.0.1"
port = 5432
database = "gmeow"
user = "gmeow"
ssl_mode = "require"

[rabbitmq]
host = "127.0.0.1"
port = 5672
user = "gmeow"
vhost = "gmeow-prod"
test_user = "gmeow-test"
test_vhost = "gmeow-test"

[scheduler]
scan_interval = "30s"
retry_limit = 3
retry_backoff = "30s"
queue_prefix = "gmeow."
dead_letter_inspect_max = 20
backpressure_high_water = 10000
backpressure_low_water = 5000
self_heal_chunk_size = 500
self_heal_idle_threshold = "5m"
fully_annotated_cache_size = 100000

[scheduler.priorities]
interactive = 100
forced = 90
fresh_ingest = 70
repair = 50
background = 10

[secrets]
# PostgreSQL and RabbitMQ are mandatory. Store only passwords as SOPS JSON leaf envelopes.
postgres_password = '''
{"data":"ENC[AES256_GCM,data:...leaf ciphertext...,type:str]","sops":{"age":[{"recipient":"age1...","enc":"-----BEGIN AGE ENCRYPTED FILE-----\n...\n-----END AGE ENCRYPTED FILE-----\n"}],"version":"3.13.1"}}
'''
rabbitmq_password = '''
{"data":"ENC[AES256_GCM,data:...leaf ciphertext...,type:str]","sops":{"age":[{"recipient":"age1...","enc":"-----BEGIN AGE ENCRYPTED FILE-----\n...\n-----END AGE ENCRYPTED FILE-----\n"}],"version":"3.13.1"}}
'''
rabbitmq_test_password = '''
{"data":"ENC[AES256_GCM,data:...leaf ciphertext...,type:str]","sops":{"age":[{"recipient":"age1...","enc":"-----BEGIN AGE ENCRYPTED FILE-----\n...\n-----END AGE ENCRYPTED FILE-----\n"}],"version":"3.13.1"}}
'''

[[interfaces]]
name = "rest"
kind = "rest"
host = "127.0.0.1"
port = 8765

[[interfaces]]
name = "mcp"
kind = "mcp"
host = "127.0.0.1"
port = 9876
session_timeout = "30m"

[[interfaces]]
name = "imap"
kind = "imap"
host = "127.0.0.1"
port = 1143
username = "gmeow"
facets = ["mail_message"]

[[interfaces]]
name = "jmap"
kind = "jmap"
host = "127.0.0.1"
port = 8780
password = "change-me"
facets = ["mail_message"]

[analysis]
# Default per-analyzer consumer concurrency, used for any analyzer that does not
# set its own `workers`. Each analyzer has its own work queue, so a slow
# model-backed analyzer never blocks a fast in-process one; set `workers` per
# analyzer below (wide for cheap in-process analyzers, ~backend capacity for
# model-backed ones).
worker_concurrency = 1
# Persistent external (Python/model) backends load their models once and stay
# resident. Reap a backend after this much idle time to reclaim memory; allow a
# slow first model load this long before treating the backend as unavailable.
backend_idle_timeout = "60m"
backend_startup_timeout = "60s"

[analysis.summary]
endpoint = "http://127.0.0.1:8082/v1/chat/completions"
model = "gemma-4-E4B-it-uncensored-Q4_K_M.gguf"

[[analysis.analyzers]]
name = "text.extract"
version = "phase04-email-v2"
worker_kind = "go"
# Cheap in-process analyzer: drain its queue wide (bounded by CPU cores).
workers = 8

[[analysis.analyzers]]
name = "rfc822.headers"
version = "phase04-email-v2"
worker_kind = "go"
workers = 8

[[analysis.analyzers]]
name = "metadata.extract"
version = "phase04-email-v2"
worker_kind = "go"
workers = 8

[[analysis.analyzers]]
name = "graph.facts"
version = "phase04-email-v2"
workers = 8
worker_kind = "go"

[[analysis.analyzers]]
name = "embedding.endpoint"
version = "phase04-email-v2"
worker_kind = "go"

[[analysis.analyzers]]
name = "summary.model"
version = "phase04-email-v2"
worker_kind = "go"

# Quality-critical Python/model analyzers must be explicit external adapters.
# They are managed by the Go worker, which owns scheduler-delivered jobs,
# gRPC FILESTORE access, and ack/nack.
[[analysis.analyzers]]
name = "ner.spacy"
version = "python-email-v1"
worker_kind = "python"
command = "gmeow-intel"
# "serve" keeps the backend resident (models load once); the worker streams one
# object per request over stdin/stdout. max_instances bounds concurrent backends
# for this tag (default 1 = serial).
args = ["serve", "ner.spacy"]
timeout = "20m"
max_instances = 1

[[analysis.analyzers]]
name = "categories.sklearn"
version = "python-email-v1"
worker_kind = "python"
command = "gmeow-intel"
args = ["serve", "categories.sklearn"]
timeout = "20m"
max_instances = 1

[[search.backends]]
name = "query"
kind = "query"
facets = ["*"]

