[system]
config_version = 1
instance_id = "local"
data_dir = "data"

[filestore]
root = "data/filestore"

[postgres]
enabled = false
host = "127.0.0.1"
port = 5432
database = "gmeow"
user = "gmeow"
password_secret = ""
ssl_mode = "disable"

[rabbitmq]
enabled = false
url_secret = ""

[secrets]

[[interfaces]]
name = "rest"
kind = "rest"
enabled = true
host = "127.0.0.1"
port = 8765

[[interfaces]]
name = "mcp"
kind = "mcp"
enabled = true
host = "127.0.0.1"
port = 8765

[[analysis.analyzers]]
name = "noop"
version = "phase00"
enabled = true
worker_kind = "go"

[[search.backends]]
name = "query"
kind = "query"
enabled = true
facets = ["*"]
